unit dao.perfil;

interface

uses
  ADRConn.DAO.Base,
  ADRConn.Model.Factory,
  ADRConn.Model.Interfaces,

  Dataset.Serialize,

  System.Classes,
  System.JSON,
  System.StrUtils,
  System.SysUtils;

type
  TADRConnDAOPerfil = class(TADRConnDAOBase)
    private
    public
      function List(): TJSONArray;
      function Find(ACOD_PERFIL_ESPECIAL: Integer): TJSONObject;
      function FindPerfil(APERFIL: String): TJSONObject;
      function Update(ACOD_PERFIL_ESPECIAL: Integer; AValue: string): TJSONArray;
      function Insert(AValue: string): TJSONObject;
      function Login(AValue: string): TJSONObject;
  end;

implementation

{ TADRConnDAOPerfil }

function TADRConnDAOPerfil.List: TJSONArray;
{$Region 'SELECT'}
const
  LSelect =
    'SELECT COD_PERFIL_ESPECIAL, PERFIL, DESCRICAO, FIGURA FROM PERFIL_ESPECIAL ORDER BY PERFIL';
{$EndRegion}
var
  LDataSet : TDataSet;
begin
  try
    try
      LDataset :=
        FQuery
          .SQL(LSelect)
          .OpenDataSet;

      Result := LDataset.ToJSONArray;
    except
      Result := TJSONArray.Create;
    end;
  finally
    LDataSet.Free;
  end;
end;

function TADRConnDAOPerfil.Login(AValue: string): TJSONObject;
{$Region 'SELECT'}
const
  LSelect =
    'SELECT ID, USUARIO, SENHA, TIPOUSUARIO FROM USUARIOS WHERE UPPER(USUARIO) =:pUSUARIO AND SENHA =:pSENHA';
{$EndRegion}
var
  LDataSet : TDataSet;
  LUsuario : string;
  LSenha   : string;
  LJSON    : TJSONValue;
begin
  try
    try
      LJSON    := TJSONObject.ParseJSONValue(AValue) as TJSONValue;
      LUsuario := LJSON.GetValue<string>('usuario');
      LSenha   := LJSON.GetValue<string>('senha');

      LDataSet :=
        FQuery
          .SQL(LSelect)
          .ParamAsString('pUSUARIO', UpperCase(LUsuario))
          .ParamAsString('pSENHA', LSenha)
          .OpenDataSet;

      Result := LDataSet.ToJSONObject;
    except
      Result := TJSONObject.Create;
    end;
  finally
    LDataSet.Free;
  end;
end;

function TADRConnDAOPerfil.Find(ACOD_PERFIL_ESPECIAL: Integer): TJSONObject;
{$Region 'SELECT'}
const
  LSelect =
    'SELECT COD_PERFIL_ESPECIAL, PERFIL, DESCRICAO, FIGURA FROM PERFIL_ESPECIAL WHERE COD_PERFIL_ESPECIAL = :pCOD_PERFIL_ESPECIAL ORDER BY COD_PERFIL_ESPECIAL';
{$EndRegion}
var
  LDataSet : TDataSet;
begin
  try
    try
      LDataset :=
        FQuery
          .SQL(LSelect)
          .ParamAsInteger('pCOD_PERFIL_ESPECIAL', ACOD_PERFIL_ESPECIAL)
          .OpenDataSet;

      Result := LDataset.ToJSONObject;
    except
      Result := TJSONObject.Create;
    end;
  finally
    LDataSet.Free;
  end;
end;

function TADRConnDAOPerfil.FindPerfil(APERFIL: String): TJSONObject;
{$Region 'SELECT'}
const
  LSelect =
    'SELECT '+
    '  FIRST 1 '+
    '  PERFIL_ESPECIAL.COD_PERFIL_ESPECIAL, PERFIL_ESPECIAL.PERFIL, PERFIL_ESPECIAL.DESCRICAO, PERFIL_ESPECIAL.FIGURA  '+
    'FROM '+
    '  PERFIL_ESPECIAL '+
    '  LEFT JOIN PERFIL_ESPECIAL_MERCADO ON PERFIL_ESPECIAL_MERCADO.cod_perfil_especial = PERFIL_ESPECIAL.cod_perfil_especial '+
    'WHERE '+
    '  PERFIL_ESPECIAL.PERFIL = :PERFIL or PERFIL_ESPECIAL_MERCADO.PERFIL_MERCADO = :PERFIL ';
{$EndRegion}
var
  LDataSet : TDataSet;
begin
  try
    try
      LDataset :=
        FQuery
          .SQL(LSelect)
          .ParamAsInteger('pPERFIL', APERFIL)
          .OpenDataSet;

      Result := LDataset.ToJSONObject;
    except
      Result := TJSONObject.Create;
    end;
  finally
    LDataSet.Free;
  end;
end;

function TADRConnDAOPerfil.Update(ACOD_PERFIL_ESPECIAL: Integer; AValue: string): TJSONArray;
{$Region 'SELECT'}
const
  LSelect =
    'SELECT COD_PERFIL_ESPECIAL, PERFIL, DESCRICAO, FIGURA FROM PERFIL_ESPECIAL WHERE COD_PERFIL_ESPECIAL = :pCOD_PERFIL_ESPECIAL ORDER BY COD_PERFIL_ESPECIAL';
{$EndRegion}
var
  LDataSet : TDataSet;
begin
  try
    try
      LDataSet :=
        FQuery
          .SQL(LSelect)
          .ParamAsInteger('pCOD_PERFIL_ESPECIAL', ACOD_PERFIL_ESPECIAL)
          .OpenDataSet;

      LDataSet
        .MergeFromJSONObject(AValue);

      Result := LDataSet.ToJSONArray;
    except
      Result := TJSONArray.Create;
    end;
  finally
    LDataSet.Free;
  end;
end;

function TADRConnDAOPerfil.Insert(AValue: string): TJSONObject;
{$Region 'SELECT'}
const
  LSelect =
    'SELECT COD_PERFIL_ESPECIAL, PERFIL, DESCRICAO, FIGURA FROM PERFIL_ESPECIAL WHERE WHERE 1 = 2';
{$EndRegion}
var
  LDataSet : TDataSet;
begin
  try
    try
      LDataSet :=
        FQuery
          .SQL(LSelect)
          .OpenDataSet;

      LDataSet
        .LoadFromJSON(AValue);

      Result := LDataSet.ToJSONObject;
    except
      Result := TJSONObject.Create;
    end;
  finally
    LDataSet.Free;
  end;
end;


end.
